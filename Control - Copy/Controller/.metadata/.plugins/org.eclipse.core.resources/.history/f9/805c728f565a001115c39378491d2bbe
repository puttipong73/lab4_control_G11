static uint8_t prev_traj_active_m3 = 0;   // Mode 3: detects trajectory completion in TIM7
static uint8_t  seq_was_enabled     = 0;       // sequence rising-edge detector
static uint8_t  seq_step_done       = 0;       // 1 = step settled, counting delay
static uint32_t seq_delay_counter   = 0;       // TIM7 ticks remaining in inter-step delay
static float   kf_sine_phase       = 0.0f; // Mode 7: sine wave phase accumulator (rad)

// --- NEW PWM OUTPUT FUNCTION ---
// Assumes pwm_duty comes from the PID as a float between -100.0f and 100.0f
void Set_Motor_PWM(float pwm_duty) {

    // 0. Apply direction inversion if motor wiring is physically reversed
    if (motor_dir_inverted) pwm_duty = -pwm_duty;

    // 1. Determine direction and set the GPIO pin
    if (pwm_duty >= 0.0f) {
        // Forward
        HAL_GPIO_WritePin(MOTOR_DIR_Pin_GPIO_Port, MOTOR_DIR_Pin_Pin, GPIO_PIN_SET);
    } else {
        // Reverse
        HAL_GPIO_WritePin(MOTOR_DIR_Pin_GPIO_Port, MOTOR_DIR_Pin_Pin, GPIO_PIN_RESET);
        // Make duty cycle positive for the timer
        pwm_duty = -pwm_duty;
    }

    // 2. Apply minimum threshold to overcome motor dead zone / static friction.
    //    Only applies when a non-zero PWM was requested (pwm_duty is positive here
    //    because the sign was handled above). Set_Motor_PWM(0) stays at zero.
    if (pwm_duty > 0.0f && pwm_duty < min_pwm_threshold) {
        pwm_duty = min_pwm_threshold;
    }

    // 3. Clamp duty cycle to absolute max (100.0%) to prevent overflow
    if (pwm_duty > 100.0f) {
        pwm_duty = 100.0f;
    }

    // 3. Map the percentage (0-100) to your Timer's ARR value (0-1000)
    // Formula: (Duty % / 100) * ARR
    uint32_t compare_value = (uint32_t)((pwm_duty / 100.0f) * 1000.0f);

    // 4. Write directly to the hardware register for zero latency
    __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_4, compare_value);
}


/* Internal helper: (re)start whichever trajectory generator is active.
 * displacement = target_rad - current_pos  (actual distance to travel).
 *
 * Always uses time-based profile. t_cruise is computed automatically so that
 * v_peak = max_velocity. For short moves where |displacement| < max_velocity *
 * accel_time, t_cruise clamps to 0 and v_peak < max_velocity (triangle/parabola). */
static void Start_Trajectory(float displacement) {
    traj_start_pos = my_encoder.position_rad;
    float abs_disp = fabsf(displacement);

    if (traj_type == TRAJ_TRAPEZOID) {
        Trapezoid_Init(&my_trapezoid, max_velocity, max_accel, POS_DT);
        // t_acc_seg, t_cruise_seg, t_dec_seg are user-specified in Live Expressions.
        // v_peak = |d| / (t_acc/2 + t_cruise + t_dec/2) — back-computed from times.
        // v_peak clamped to max_velocity only if it exceeds it; t_cruise unchanged.
        Trapezoid_SetTarget_ByTime(&my_trapezoid, displacement,
                                   t_acc_seg, t_cruise_seg, t_dec_seg);
        // Write back actual cruise time — T2-T1 may be larger than t_cruise_seg
        // when v_peak was clamped to max_velocity to cover the full displacement.
        t_cruise_seg = my_trapezoid.T2 - my_trapezoid.T1;
    } else {
        SCurve_Init(&my_scurve, max_velocity, max_accel, max_jerk, POS_DT);
        // v_peak = d / (2*t1 + t2 + t_cruise)  →  t_cruise = d/v_max - 2*t1 - t2
        float t_cruise = (max_velocity > 0.0f)
                         ? (abs_disp / max_velocity - 2.0f * t1_seg - t2_seg)
                         : 0.0f;
        if (t_cruise < 0.0f) t_cruise = 0.0f;
        t_cruise_seg = t_cruise;
        SCurve_SetTarget_ByTime(&my_scurve, displacement, t1_seg, t2_seg, t_cruise);
    }
    Velocity_PID_Reset();
    Position_PID_Reset();
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim) {

    // =========================================================================
    // TIM6 — 1 kHz INNER LOOP: encoder update + velocity PID + PWM output
    // =========================================================================
    if (htim->Instance == TIM6) {

        uint16_t raw_timer = __HAL_TIM_GET_COUNTER(&htim1);
        Encoder_Update(&my_encoder, raw_timer);

        HAL_ADC_Stop(&hadc1);
        HAL_ADC_Start(&hadc1);
        while (!(hadc1.Instance->ISR & ADC_ISR_EOC));   // spin ~300 ns for conversion
        adc_raw_current = hadc1.Instance->DR & 0x0FFFu; // reading DR clears EOC
        g_current_A = (((float)adc_raw_current - current_zero_counts) / current_counts_per_amp)-1.2;

        // Kalman (2-state) — update R and Q from current Live Expression values
        // every tick so noise parameters take effect immediately without reset_all.
        // Q = F·QA·Fᵀ  (F=[[1,dt],[0,1]], QA=diag(0,q))  resolves to:
        //   [[dt²·q, dt·q],
        //    [dt·q,  q   ]]
        my_kf.R_data[0] = kf_meas_noise;
        {
            float _q       = kf_proc_vel_noise;
            my_kf.Q_data[0] = LOOP_DT * LOOP_DT * _q;
            my_kf.Q_data[1] = LOOP_DT * _q;
            my_kf.Q_data[2] = LOOP_DT * _q;
            my_kf.Q_data[3] = _q;
        }
        float kf_vel = Kalman_Update(&my_kf, my_encoder.position_rad, 0.0f, LOOP_DT, 1);
        g_kf_velocity = kf_vel;
        g_kf_position = my_kf.x_data[0];

        // Kalman4 (4-state motor model) — runs every tick.
        // Voltage estimated from last-cycle PWM duty; 1-sample lag is negligible at 1 kHz.
        float kf4_v = (g_pwm_duty / 100.0f) * V_supply;
        if (motor_dir_inverted) kf4_v = -kf4_v;
        float *kf4_st = Kalman4_Update(&my_kf4, my_encoder.position_rad, kf4_v);
        g_kf4_position  = kf4_st[0];
        g_kf4_velocity  = kf4_st[1];
        g_kf4_current   = kf4_st[2];
        g_kf4_tau_d_obs = kf4_st[3];

        float pwm_out = 0.0f;

        if (hard_stop_active || !pid_enabled) {
            // Hard stop OR PID disabled — reset vel PID integrator and hold zero
            Velocity_PID_Reset();
            Set_Motor_PWM(0.0f);

        } else {
            switch (control_mode) {

                // Modes 1, 2, 6: TIM7 computes PWM directly → apply it here
                case MODE_TRAJ_TEST:
                case MODE_POSITION_CTRL:
                case MODE_DIRECT_POS:
                    Set_Motor_PWM(pwm_command);
                    pwm_out = pwm_command;
                    break;

                // Modes 3, 5: TIM7 computes vel_command → velocity PID here
                case MODE_CASCADE_CTRL:
                case MODE_POS_VEL_CTRL: {
                    float vel_fb    = kalman_enabled ? kf_vel : my_encoder.velocity_rad_s;
                    float vel_error = vel_command - vel_fb;
                    vel_error_live  = vel_error;
                    pwm_out = Velocity_PID_Controller(vel_error);

                    // Model-based voltage feedforward: converts vel_command (rad/s)
                    // to an equivalent PWM% that pre-compensates motor dynamics.
                    if (refff_enabled && V_supply > 0.1f) {
                        float v_ff   = RefFF_Update(&my_refff, vel_command);
                        float pwm_ff = v_ff / V_supply * 100.0f;
                        pwm_out += pwm_ff;
                    }

                    if (pwm_out >  max_pwm) pwm_out =  max_pwm;
                    if (pwm_out < -max_pwm) pwm_out = -max_pwm;
                    Set_Motor_PWM(pwm_out);
                    break;
                }

                case MODE_ENCODER_TEST:
                    Set_Motor_PWM(0.0f);
                    enc_position_deg = my_encoder.position_rad * (180.0f / 3.14159265f);
                    enc_velocity_rpm = my_encoder.velocity_rad_s * (60.0f / (2.0f * 3.14159265f));
                    enc_raw_counter  = (uint32_t)raw_timer;
                    enc_count_accum  = my_encoder.count_accum;
                    g_traj_pos     = 0.0f;
                    g_smooth_vel   = enc_position_deg;
                    g_smooth_accel = enc_velocity_rpm;
                    g_jerk         = 0.0f;
                    break;

                // Mode 7: Kalman4 calibration — direct PWM, Kalman4 state in telemetry
                case MODE_KALMAN_CAL:
                    Set_Motor_PWM(pwm_command);
                    pwm_out = pwm_command;
                    // Repurpose telemetry channels for Kalman4 state comparison:
                    //  bytes  2- 5 : Kalman4 position estimate  (compare with bytes 18-21)
                    //  bytes  6- 9 : Kalman4 velocity estimate  (compare with bytes 22-25)
                    //  bytes 10-13 : Kalman4 current estimate   (model-only)
                    //  bytes 14-17 : Kalman4 τ_d estimate
                    //  bytes 18-21 : actual encoder position    (unchanged)
                    //  bytes 22-25 : actual raw velocity        (unchanged)
                    //  bytes 26-29 : Kalman4 velocity           (standard Kalman slot)
                    g_traj_pos     = g_kf4_position;
                    g_smooth_vel   = g_kf4_velocity;
                    g_smooth_accel = g_kf4_current;
                    g_jerk         = g_kf4_tau_d_obs;
                    g_kf_velocity  = g_kf4_velocity;
                    break;

                default:
                    Set_Motor_PWM(0.0f);
                    break;
            }
        }

        g_position_rad   = my_encoder.position_rad;
        g_velocity_rad_s = my_encoder.velocity_rad_s;
        g_pwm_duty       = pwm_out;

        if (!tx_pending) {
            Pack_Telemetry();
            tx_pending = 1;
        }
        return;
    }

    // =========================================================================
    // TIM7 — 500 Hz OUTER LOOP: position PID + trajectory generation
    // =========================================================================
    if (htim->Instance != TIM7) return;

    // --- Full state reset ---
    if (reset_all) {
        reset_all = 0;
        // Re-init trajectory generators — zeros p_current, t_now, v/a/j_current, is_active
        SCurve_Init(&my_scurve, max_velocity, max_accel, max_jerk, POS_DT);
        Trapezoid_Init(&my_trapezoid, max_velocity, max_accel, POS_DT);
        traj_start_pos         = 0.0f;   // g_traj_pos = traj_start_pos + p_current = 0
        t_cruise_seg           = 0.0f;
        // Reset encoder position to zero
        __HAL_TIM_SET_COUNTER(&htim1, 0);
        Encoder_Init(&my_encoder, LOOP_DT);
        // Clear inter-loop commands
        vel_command            = 0.0f;
        pwm_command            = 0.0f;
        hard_stop_active       = 0;
        prev_traj_active_m3    = 0;
        // Reset all PID integrators and feedforward state
        Velocity_PID_Reset();
        Position_PID_Reset();
        RefFF_Reset(&my_refff);
        Kalman_Init(&my_kf, 0.0f, LOOP_DT, 0.0f, kf_meas_noise, 0.0f, kf_proc_vel_noise, 1);
        Kalman4_Init(&my_kf4, 0.0f, 0.0f, 0.0f, LOOP_DT,
                     0.027f, 0.3f, 50.0f, 0.045f, 0.005f, 0.0012794f, 2.8f,
                     kf4_q_vel, kf4_q_tau_d, kf4_r_theta);
        g_kf4_velocity  = 0.0f;
        g_kf4_current   = 0.0f;
        g_kf4_tau_d_obs = 0.0f;
        kf_sine_phase          = 0.0f;
        pos6_integral          = 0.0f;
        // Clear telemetry and debug observables
        g_position_rad         = 0.0f;
        g_velocity_rad_s       = 0.0f;
        g_traj_pos             = 0.0f;
        g_smooth_vel           = 0.0f;
        g_smooth_accel         = 0.0f;
        g_jerk                 = 0.0f;
        g_pwm_duty             = 0.0f;
        ss_error_deg           = 0.0f;
        ss_error_rad           = 0.0f;
        vel_error_live         = 0.0f;
        i_term_live            = 0.0f;
        // Abort any running sequence
        seq_enabled            = 0;
        seq_index              = 0;
        seq_was_enabled        = 0;
        seq_step_done          = 0;
        seq_delay_counter      = 0;
        // Sync prev_target so auto-retrigger does not double-fire
        prev_traj_target_deg   = traj_target_deg;
        // Force mode-change handler to fire on the very next tick →
        // Start_Trajectory is called automatically toward current traj_target_deg
        prev_control_mode      = 0xFF;
        prev_traj_type         = 0xFF;
    }

    // --- Zero encoder on demand ---
    if (zero_encoder) {
        zero_encoder = 0;
        __HAL_TIM_SET_COUNTER(&htim1, 0);
        Encoder_Init(&my_encoder, LOOP_DT);
        g_position_rad   = 0.0f;
        g_velocity_rad_s = 0.0f;
        vel_command      = 0.0f;
        pwm_command      = 0.0f;
        hard_stop_active = 0;
        prev_traj_active_m3 = 0;
        Position_PID_Reset();
        Velocity_PID_Reset();
        Kalman4_Reset(&my_kf4, 0.0f, 0.0f, 0.0f);
        g_kf4_velocity  = 0.0f;
        g_kf4_current   = 0.0f;
        g_kf4_tau_d_obs = 0.0f;
        pos6_integral    = 0.0f;
    }

    // --- Mode / trajectory-type change ---
    if (control_mode != prev_control_mode || traj_type != prev_traj_type) {
        SCurve_Init(&my_scurve, max_velocity, max_accel, max_jerk, POS_DT);
        Trapezoid_Init(&my_trapezoid, max_velocity, max_accel, POS_DT);
        Velocity_PID_Reset();
        Position_PID_Reset();
        pos6_integral       = 0.0f;
        vel_command         = 0.0f;
        pwm_command         = 0.0f;
        hard_stop_active    = 0;
        prev_traj_active_m3 = 0;
        Kalman4_Reset(&my_kf4, my_encoder.position_rad, 0.0f, 0.0f);
        prev_control_mode   = control_mode;
        prev_traj_type      = traj_type;
        if (control_mode == MODE_TRAJ_TEST    ||
            control_mode == MODE_POSITION_CTRL ||
            control_mode == MODE_CASCADE_CTRL) {
            float disp = traj_target_deg * DEG_TO_RAD - my_encoder.position_rad;
            Start_Trajectory(disp);
        }
    }

    // --- Sequence mode ---
    // Rising edge: load step 0; auto-retrigger below starts the trajectory.
    // Settled state: counts down seq_step_delay before loading the next target.
    if (seq_enabled && !seq_was_enabled) {
        if (seq_count >= 1 && seq_count <= 9) {
            seq_index         = 0;
            seq_step_done     = 0;
            seq_delay_counter = 0;
            traj_target_deg   = seq_targets[0];
        } else {
            seq_enabled = 0;
        }
    } else if (seq_enabled) {
        if (!seq_step_done) {
            // Waiting for trajectory to finish and position to settle
            uint8_t traj_done    = (traj_type == TRAJ_TRAPEZOID) ? !my_trapezoid.is_active
                                                                  : !my_scurve.is_active;
            float   deadband_rad = pos_deadband_deg * DEG_TO_RAD;
            float   pos_err      = fabsf(my_encoder.position_rad - seq_targets[seq_index] * DEG_TO_RAD);
            if (traj_done && pos_err <= deadband_rad) {
                seq_step_done     = 1;
                seq_delay_counter = (uint32_t)(seq_step_delay / POS_DT);
            }
        } else {
            // Step settled — count down inter-step delay then advance
            if (seq_delay_counter > 0) {
                seq_delay_counter--;
            } else {
                seq_step_done = 0;
                seq_index++;
                if (seq_index >= seq_count) {
                    seq_enabled = 0;   // sequence complete
                } else {
                    traj_target_deg = seq_targets[seq_index];
                }
            }
        }
    }
    seq_was_enabled = seq_enabled;

    // --- Auto-retrigger when target position changes ---
    if (traj_target_deg != prev_traj_target_deg) {
        prev_traj_target_deg = traj_target_deg;
        hard_stop_active = 0;
        if (control_mode == MODE_TRAJ_TEST    ||
            control_mode == MODE_POSITION_CTRL ||
            control_mode == MODE_CASCADE_CTRL) {
            float disp = traj_target_deg * DEG_TO_RAD - my_encoder.position_rad;
            Start_Trajectory(disp);
        }
    }

    // --- Manual retrigger ---
    if (start_move) {
        start_move       = 0;
        hard_stop_active = 0;
        float disp = traj_target_deg * DEG_TO_RAD - my_encoder.position_rad;
        Start_Trajectory(disp);
    }

    // --- PID master enable gate ---
    if (!pid_enabled) {
        vel_command      = 0.0f;
        pwm_command      = 0.0f;
        hard_stop_active = 0;
        Position_PID_Reset();
        return;   // skip trajectory advance and position PID entirely
    }


    switch (control_mode) {

        case MODE_TRAJ_TEST: {
            float smooth_vel, smooth_accel, p_rel, jerk_out;
            if (traj_type == TRAJ_TRAPEZOID) {
                Trapezoid_Update(&my_trapezoid);
                smooth_vel   = my_trapezoid.v_current;
                smooth_accel = my_trapezoid.a_current;
                p_rel        = my_trapezoid.p_current;
                jerk_out     = 0.0f;
            } else {
                SCurve_Update(&my_scurve);
                smooth_vel   = my_scurve.v_current;
                smooth_accel = my_scurve.a_current;
                p_rel        = my_scurve.p_current;
                jerk_out     = my_scurve.j_current;
            }
            pwm_command    = (smooth_vel / max_velocity) * 100.0f;
            g_traj_pos     = traj_start_pos + p_rel;
            g_smooth_vel   = smooth_vel;
            g_smooth_accel = smooth_accel;
            g_jerk         = jerk_out;
            break;
        }

        case MODE_POSITION_CTRL: {
            float smooth_vel, smooth_accel, p_rel, jerk_out;
            uint8_t traj_active;
            if (traj_type == TRAJ_TRAPEZOID) {
                Trapezoid_Update(&my_trapezoid);
                smooth_vel   = my_trapezoid.v_current;
                smooth_accel = my_trapezoid.a_current;
                p_rel        = my_trapezoid.p_current;
                traj_active  = my_trapezoid.is_active;
                jerk_out     = 0.0f;
            } else {
                SCurve_Update(&my_scurve);
                smooth_vel   = my_scurve.v_current;
                smooth_accel = my_scurve.a_current;
                p_rel        = my_scurve.p_current;
                traj_active  = my_scurve.is_active;
                jerk_out     = my_scurve.j_current;
            }

            float pos_abs_ideal = traj_start_pos + p_rel;
            float pos_error     = pos_abs_ideal - my_encoder.position_rad;
            float deadband_rad  = pos_deadband_deg * DEG_TO_RAD;
            ss_error_rad = pos_error;
            ss_error_deg = pos_error * (180.0f / 3.14159265f);

            if (!traj_active &&
                fabsf(pos_error) <= deadband_rad &&
                fabsf(my_encoder.velocity_rad_s) < 0.05f) {
                Position_PID_Reset();
                pwm_command      = 0.0f;
                hard_stop_active = 1;
            } else {
                hard_stop_active = 0;
                float pwm = kp_pos_pwm * pos_error - kd_pos_pwm * my_encoder.velocity_rad_s;
                if (pwm >  max_pwm) pwm =  max_pwm;
                if (pwm < -max_pwm) pwm = -max_pwm;
                pwm_command = pwm;
            }

            g_traj_pos     = traj_start_pos + p_rel;
            g_smooth_vel   = smooth_vel;
            g_smooth_accel = smooth_accel;
            g_jerk         = jerk_out;
            break;
        }

        case MODE_CASCADE_CTRL: {
            float smooth_vel, smooth_accel, pos_ideal, jerk_out;
            uint8_t traj_active;
            if (traj_type == TRAJ_TRAPEZOID) {
                Trapezoid_Update(&my_trapezoid);
                smooth_vel   = my_trapezoid.v_current;
                smooth_accel = my_trapezoid.a_current;
                pos_ideal    = my_trapezoid.p_current;
                traj_active  = my_trapezoid.is_active;
                jerk_out     = 0.0f;
            } else {
                SCurve_Update(&my_scurve);
                smooth_vel   = my_scurve.v_current;
                smooth_accel = my_scurve.a_current;
                pos_ideal    = my_scurve.p_current;
                traj_active  = my_scurve.is_active;
                jerk_out     = my_scurve.j_current;
            }

            if (prev_traj_active_m3 && !traj_active) {
                Velocity_PID_Reset();
                Position_PID_Reset();
            }
            prev_traj_active_m3 = traj_active;

            float pos_abs_ideal  = traj_start_pos + pos_ideal;
            float pos_error      = pos_abs_ideal - my_encoder.position_rad;
            float deadband_rad   = pos_deadband_deg * DEG_TO_RAD;
            ss_error_rad = pos_error;
            ss_error_deg = pos_error * (180.0f / 3.14159265f);

            float vel_correct = Position_PID_Controller(pos_error, my_encoder.velocity_rad_s);
            if (vel_correct >  max_velocity) vel_correct =  max_velocity;
            if (vel_correct < -max_velocity) vel_correct = -max_velocity;

            if (!traj_active &&
                fabsf(pos_error) <= deadband_rad &&
                fabsf(my_encoder.velocity_rad_s) < 0.05f) {
                Position_PID_Reset();
                vel_command      = 0.0f;
                hard_stop_active = 1;  // TIM6 will call Velocity_PID_Reset()
            } else {
                hard_stop_active = 0;
                float vel_cmd = smooth_vel + vel_correct;
                if (vel_cmd >  max_velocity) vel_cmd =  max_velocity;
                if (vel_cmd < -max_velocity) vel_cmd = -max_velocity;
                vel_command = vel_cmd;
            }

            g_traj_pos     = traj_start_pos + pos_ideal;
            g_smooth_vel   = smooth_vel;
            g_smooth_accel = smooth_accel;
            g_jerk         = jerk_out;
            break;
        }

        case MODE_ENCODER_TEST:
            vel_command      = 0.0f;
            pwm_command      = 0.0f;
            hard_stop_active = 0;
            break;

        // Mode 7: Kalman4 calibration — direct PWM or sine excitation signal
        case MODE_KALMAN_CAL: {
            float cal_out;
            if (kf_sine_enabled) {
                // Advance phase accumulator: Δφ = 2π × freq × POS_DT
                kf_sine_phase += 2.0f * 3.14159265f * kf_sine_freq * POS_DT;
                if (kf_sine_phase >= 2.0f * 3.14159265f)
                    kf_sine_phase -= 2.0f * 3.14159265f;
                // kf_cal_pwm = DC offset, kf_sine_dir = +1 normal / -1 reversed
                cal_out = kf_cal_pwm + kf_sine_dir * kf_sine_amp * sinf(kf_sine_phase);
                if (cal_out >  100.0f) cal_out =  100.0f;
                if (cal_out < -100.0f) cal_out = -100.0f;
            } else {
                kf_sine_phase = 0.0f;   // reset phase when sine is off
                cal_out = kf_cal_pwm;
            }
            pwm_command      = cal_out;
            vel_command      = 0.0f;
            hard_stop_active = 0;
            g_traj_pos     = 0.0f;
            g_smooth_vel   = 0.0f;
            g_smooth_accel = 0.0f;
            g_jerk         = 0.0f;
            break;
        }

        case MODE_POS_VEL_CTRL: {
            float target_rad   = traj_target_deg * DEG_TO_RAD;
            float pos_error    = target_rad - my_encoder.position_rad;
            float deadband_rad = pos_deadband_deg * DEG_TO_RAD;
            ss_error_rad = pos_error;
            ss_error_deg = pos_error * (180.0f / 3.14159265f);

            if (fabsf(pos_error) <= deadband_rad && fabsf(my_encoder.velocity_rad_s) < 0.05f) {
                Position_PID_Reset();
                vel_command      = 0.0f;
                hard_stop_active = 1;
                g_traj_pos     = 0.0f;
                g_smooth_vel   = 0.0f;
                g_smooth_accel = 0.0f;
                g_jerk         = 0.0f;
                break;
            }
            hard_stop_active = 0;

            float vel_cmd = Position_PID_Controller(pos_error, my_encoder.velocity_rad_s);
            if (vel_cmd >  max_velocity) vel_cmd =  max_velocity;
            if (vel_cmd < -max_velocity) vel_cmd = -max_velocity;
            vel_command = vel_cmd;

            g_traj_pos     = 0.0f;
            g_smooth_vel   = 0.0f;
            g_smooth_accel = 0.0f;
            g_jerk         = 0.0f;
            break;
        }

        case MODE_DIRECT_POS: {
            float target_rad   = traj_target_deg * DEG_TO_RAD;
            float pos_error    = target_rad - my_encoder.position_rad;
            float deadband_rad = pos_deadband_deg * DEG_TO_RAD;
            ss_error_rad = pos_error;
            ss_error_deg = pos_error * (180.0f / 3.14159265f);

            if (fabsf(pos_error) <= deadband_rad &&
                fabsf(my_encoder.velocity_rad_s) < 0.05f) {
                pos6_integral    = 0.0f;
                pwm_command      = 0.0f;
                hard_stop_active = 1;
                g_traj_pos     = 0.0f;
                g_smooth_vel   = 0.0f;
                g_smooth_accel = 0.0f;
                g_jerk         = 0.0f;
                break;
            }
            hard_stop_active = 0;

            pos6_integral += pos_error * POS_DT;
            float max6_int = (ki_pos_pwm > 0.0f) ? (max_pwm / ki_pos_pwm) : 0.0f;
            if (pos6_integral >  max6_int) pos6_integral =  max6_int;
            if (pos6_integral < -max6_int) pos6_integral = -max6_int;

            float pwm = kp_pos_pwm * pos_error
                      + ki_pos_pwm * pos6_integral
                      - kd_pos_pwm * my_encoder.velocity_rad_s;
            if (pwm >  max_pwm) pwm =  max_pwm;
            if (pwm < -max_pwm) pwm = -max_pwm;
            pwm_command = pwm;

            g_traj_pos     = 0.0f;
            g_smooth_vel   = 0.0f;
            g_smooth_accel = 0.0f;
            g_jerk         = 0.0f;
            break;
        }

        default:
            vel_command      = 0.0f;
            pwm_command      = 0.0f;
            hard_stop_active = 1;
            break;
    }
}



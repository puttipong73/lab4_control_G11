// --- NEW PWM OUTPUT FUNCTION ---
// Assumes pwm_duty comes from the PID as a float between -100.0f and 100.0f
void Set_Motor_PWM(float pwm_duty) {

    // 1. Determine direction and set the GPIO pin
    if (pwm_duty >= 0.0f) {
        // Forward
        HAL_GPIO_WritePin(MOTOR_DIR_Pin_GPIO_Port, MOTOR_DIR_Pin_Pin, GPIO_PIN_SET);
    } else {
        // Reverse
        HAL_GPIO_WritePin(MOTOR_DIR_Pin_GPIO_Port, MOTOR_DIR_Pin_Pin, GPIO_PIN_RESET);
        // Make duty cycle positive for the timer
        pwm_duty = -pwm_duty;
    }

    // 2. Apply minimum threshold to overcome motor dead zone / static friction.
    //    Only applies when a non-zero PWM was requested (pwm_duty is positive here
    //    because the sign was handled above). Set_Motor_PWM(0) stays at zero.
    if (pwm_duty > 0.0f && pwm_duty < min_pwm_threshold) {
        pwm_duty = min_pwm_threshold;
    }

    // 3. Clamp duty cycle to absolute max (100.0%) to prevent overflow
    if (pwm_duty > 100.0f) {
        pwm_duty = 100.0f;
    }

    // 3. Map the percentage (0-100) to your Timer's ARR value (0-1000)
    // Formula: (Duty % / 100) * ARR
    uint32_t compare_value = (uint32_t)((pwm_duty / 100.0f) * 1000.0f);

    // 4. Write directly to the hardware register for zero latency
    __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_1, compare_value);
}


/* Internal helper: (re)start whichever trajectory generator is active.
 * displacement = target_rad - current_pos  (actual distance to travel).    */
static void Start_Trajectory(float displacement) {
    traj_start_pos = my_encoder.position_rad;   // capture absolute starting pos
    if (traj_type == TRAJ_TRAPEZOID) {
        Trapezoid_Init(&my_trapezoid, max_velocity, max_accel, LOOP_DT);
        if (time_mode == 1) {
            Trapezoid_SetTarget_ByTime(&my_trapezoid, displacement,
                                       t_acc_seg, t_cruise_seg);
        } else {
            Trapezoid_SetTarget(&my_trapezoid, displacement);
        }
    } else {
        SCurve_Init(&my_scurve, max_velocity, max_accel, max_jerk, LOOP_DT);
        if (time_mode == 1) {
            SCurve_SetTarget_ByTime(&my_scurve, displacement,
                                    t1_seg, t2_seg, t_cruise_seg);
        } else {
            SCurve_SetTarget(&my_scurve, displacement);
        }
    }
    Velocity_PID_Reset();
    Position_PID_Reset();
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim) {
    if (htim->Instance != TIM6) return;

    // --- Zero encoder position on demand (Live Expressions: set zero_encoder = 1) ---
    if (zero_encoder) {
        zero_encoder = 0;
        __HAL_TIM_SET_COUNTER(&htim1, 0);
        Encoder_Init(&my_encoder, LOOP_DT);  // resets all fields + vel_buf
        vel_filtered     = 0.0f;
        g_position_rad   = 0.0f;
        g_velocity_rad_s = 0.0f;
        Position_PID_Reset();
        Velocity_PID_Reset();
        pos6_integral    = 0.0f;
    }

    // --- Handle mode / trajectory-type change via Live Expressions ---
    if (control_mode != prev_control_mode || traj_type != prev_traj_type) {
        SCurve_Init(&my_scurve, max_velocity, max_accel, max_jerk, LOOP_DT);
        Trapezoid_Init(&my_trapezoid, max_velocity, max_accel, LOOP_DT);
        Velocity_PID_Reset();
        Position_PID_Reset();
        pos6_integral = 0.0f;
        Set_Motor_PWM(0.0f);
        prev_control_mode = control_mode;
        prev_traj_type    = traj_type;
        // Auto-start trajectory for all modes that use one
        if (control_mode == MODE_TRAJ_TEST    ||
            control_mode == MODE_POSITION_CTRL ||
            control_mode == MODE_CASCADE_CTRL) {
            float disp = traj_target_deg * DEG_TO_RAD - my_encoder.position_rad;
            Start_Trajectory(disp);
        }
    }

    // --- Auto-retrigger when target position is changed in Live Expressions ---
    if (traj_target_deg != prev_traj_target_deg) {
        prev_traj_target_deg = traj_target_deg;
        if (control_mode == MODE_TRAJ_TEST    ||
            control_mode == MODE_POSITION_CTRL ||
            control_mode == MODE_CASCADE_CTRL) {
            float disp = traj_target_deg * DEG_TO_RAD - my_encoder.position_rad;
            Start_Trajectory(disp);
        }
    }

    // --- Manual retrigger: set start_move = 1 to repeat the current target ---
    if (start_move) {
        start_move = 0;
        float disp = traj_target_deg * DEG_TO_RAD - my_encoder.position_rad;
        Start_Trajectory(disp);
    }

    switch (control_mode) {

        case MODE_TRAJ_TEST: {
            /* ---- MODE 1: Open-loop trajectory test ----
             * Pre-computed profile runs from v=0 → v_peak → v=0 over
             * the given displacement. Output v_current maps to PWM directly.
             * No encoder feedback, no PID — pure profile observation.     */
            uint16_t raw_timer = __HAL_TIM_GET_COUNTER(&htim1);
            Encoder_Update(&my_encoder, raw_timer);

            float smooth_vel, smooth_accel, p_rel, jerk_out;
            if (traj_type == TRAJ_TRAPEZOID) {
                Trapezoid_Update(&my_trapezoid);
                smooth_vel   = my_trapezoid.v_current;
                smooth_accel = my_trapezoid.a_current;
                p_rel        = my_trapezoid.p_current;
                jerk_out     = 0.0f;
            } else {
                SCurve_Update(&my_scurve);
                smooth_vel   = my_scurve.v_current;
                smooth_accel = my_scurve.a_current;
                p_rel        = my_scurve.p_current;
                jerk_out     = my_scurve.j_current;
            }
            float pwm_duty = (smooth_vel / max_velocity) * 100.0f;
            Set_Motor_PWM(pwm_duty);

            g_traj_pos       = traj_start_pos + p_rel;
            g_smooth_vel     = smooth_vel;
            g_smooth_accel   = smooth_accel;
            g_jerk           = jerk_out;
            g_position_rad   = my_encoder.position_rad;
            g_velocity_rad_s = my_encoder.velocity_rad_s;
            g_pwm_duty       = pwm_duty;
            break;
        }

        case MODE_POSITION_CTRL: {
            /* ---- MODE 2: Trajectory + Position PID → direct PWM ----
             * Trajectory smooths the position reference (same generator as
             * Modes 1 & 3). Position PID tracks ideal position → PWM directly.
             * No velocity PID inner loop — simpler than Mode 3.
             *
             * Difference from Mode 3:
             *   Mode 2 → trajectory → pos PID → PWM       (1 loop)
             *   Mode 3 → trajectory → pos PID → vel PID → PWM  (2 loops)  */
            uint16_t raw_timer = __HAL_TIM_GET_COUNTER(&htim1);
            Encoder_Update(&my_encoder, raw_timer);

            float smooth_vel, smooth_accel, p_rel, jerk_out;
            uint8_t traj_active;
            if (traj_type == TRAJ_TRAPEZOID) {
                Trapezoid_Update(&my_trapezoid);
                smooth_vel   = my_trapezoid.v_current;
                smooth_accel = my_trapezoid.a_current;
                p_rel        = my_trapezoid.p_current;
                traj_active  = my_trapezoid.is_active;
                jerk_out     = 0.0f;
            } else {
                SCurve_Update(&my_scurve);
                smooth_vel   = my_scurve.v_current;
                smooth_accel = my_scurve.a_current;
                p_rel        = my_scurve.p_current;
                traj_active  = my_scurve.is_active;
                jerk_out     = my_scurve.j_current;
            }

            // Absolute ideal position from trajectory
            float pos_abs_ideal = traj_start_pos + p_rel;
            float pos_error     = pos_abs_ideal - my_encoder.position_rad;
            float deadband_rad  = pos_deadband_deg * DEG_TO_RAD;

            // Apply deadband
            float pos_error_eff = 0.0f;
            if (pos_error >  deadband_rad) pos_error_eff = pos_error - deadband_rad;
            if (pos_error < -deadband_rad) pos_error_eff = pos_error + deadband_rad;

            // Hard stop: trajectory done + inside deadband + motor settled
            if (!traj_active &&
                fabsf(pos_error) <= deadband_rad &&
                fabsf(my_encoder.velocity_rad_s) < 0.05f) {
                Position_PID_Reset();
                Set_Motor_PWM(0.0f);
                g_traj_pos       = traj_start_pos + p_rel;
                g_smooth_vel     = smooth_vel;
                g_smooth_accel   = smooth_accel;
                g_jerk           = jerk_out;
                g_position_rad   = my_encoder.position_rad;
                g_velocity_rad_s = my_encoder.velocity_rad_s;
                g_pwm_duty       = 0.0f;
                ss_error_deg     = pos_error * (180.0f / 3.14159265f);
                ss_error_rad     = pos_error;
                break;
            }

            // Position PD → direct PWM
            float pwm_duty = kp_pos_pwm * pos_error_eff
                           - kd_pos_pwm * my_encoder.velocity_rad_s;
            if (pwm_duty >  max_pwm) pwm_duty =  max_pwm;
            if (pwm_duty < -max_pwm) pwm_duty = -max_pwm;
            Set_Motor_PWM(pwm_duty);

            g_traj_pos       = traj_start_pos + p_rel;
            g_smooth_vel     = smooth_vel;
            g_smooth_accel   = smooth_accel;
            g_jerk           = jerk_out;
            g_position_rad   = my_encoder.position_rad;
            g_velocity_rad_s = my_encoder.velocity_rad_s;
            ss_error_deg     = pos_error * (180.0f / 3.14159265f);
            ss_error_rad     = pos_error;
            g_pwm_duty       = pwm_duty;
            break;
        }

        case MODE_CASCADE_CTRL: {
            /* ---- MODE 3: Full cascade control ----
             *
             * Outer loop — Position P:
             *   pos_error   = trajectory ideal position − actual position
             *   vel_correct = KP_POSITION × pos_error   (velocity correction)
             *
             * Inner loop — Velocity PID:
             *   vel_command = trajectory v_current  +  vel_correct
             *   vel_error   = vel_command − actual velocity
             *   pwm         = Velocity_PID(vel_error)
             *
             * Using p_current (trajectory ideal pos) as the position
             * reference keeps the correction proportional throughout
             * the move rather than creating a large initial demand.         */
            uint16_t raw_timer = __HAL_TIM_GET_COUNTER(&htim1);
            Encoder_Update(&my_encoder, raw_timer);

            float smooth_vel, smooth_accel, pos_ideal, jerk_out;
            uint8_t traj_active;
            if (traj_type == TRAJ_TRAPEZOID) {
                Trapezoid_Update(&my_trapezoid);
                smooth_vel   = my_trapezoid.v_current;
                smooth_accel = my_trapezoid.a_current;
                pos_ideal    = my_trapezoid.p_current;
                traj_active  = my_trapezoid.is_active;
                jerk_out     = 0.0f;
            } else {
                SCurve_Update(&my_scurve);
                smooth_vel   = my_scurve.v_current;
                smooth_accel = my_scurve.a_current;
                pos_ideal    = my_scurve.p_current;
                traj_active  = my_scurve.is_active;
                jerk_out     = my_scurve.j_current;
            }

            // --- Velocity low-pass filter ---
            vel_filtered = vel_filter_alpha * my_encoder.velocity_rad_s
                         + (1.0f - vel_filter_alpha) * vel_filtered;

            // --- Detect trajectory completion → reset both PID integrals ---
            static uint8_t prev_traj_active = 0;
            if (prev_traj_active && !traj_active) {
                Velocity_PID_Reset();
                Position_PID_Reset();
            }
            prev_traj_active = traj_active;

            // --- Outer loop: position PID with deadband ---
            float pos_abs_ideal  = traj_start_pos + pos_ideal;
            float pos_error      = pos_abs_ideal - my_encoder.position_rad;
            float deadband_rad   = pos_deadband_deg * DEG_TO_RAD;

            // Apply deadband — zero the error fed into PID when close enough
            float pos_error_eff = 0.0f;
            if (pos_error >  deadband_rad) pos_error_eff = pos_error - deadband_rad;
            if (pos_error < -deadband_rad) pos_error_eff = pos_error + deadband_rad;

            float vel_correct = Position_PID_Controller(pos_error_eff, vel_filtered);
            if (vel_correct >  max_velocity) vel_correct =  max_velocity;
            if (vel_correct < -max_velocity) vel_correct = -max_velocity;

            // --- Hard stop: trajectory done + inside deadband + motor settled ---
            // Skip PID entirely and hold zero to prevent integral from re-winding.
            if (!traj_active &&
                fabsf(pos_error) <= deadband_rad &&
                fabsf(vel_filtered) < 0.05f) {
                Velocity_PID_Reset();
                Position_PID_Reset();
                Set_Motor_PWM(0.0f);
                g_traj_pos       = traj_start_pos + pos_ideal;
                g_smooth_vel     = smooth_vel;
                g_smooth_accel   = smooth_accel;
                g_jerk           = jerk_out;
                g_position_rad   = my_encoder.position_rad;
                g_velocity_rad_s = vel_filtered;
                g_pwm_duty       = 0.0f;
                break;
            }

            // --- Inner loop: velocity PID ---
            float vel_command = smooth_vel + vel_correct;
            if (vel_command >  max_velocity) vel_command =  max_velocity;
            if (vel_command < -max_velocity) vel_command = -max_velocity;

            float vel_error = vel_command - vel_filtered;
            vel_error_live  = vel_error;
            ss_error_rad    = pos_error;
            ss_error_deg    = pos_error * (180.0f / 3.14159265f);

            float pwm_duty  = Velocity_PID_Controller(vel_error)
                            + smooth_accel * ff_gain;
            if (pwm_duty >  max_pwm) pwm_duty =  max_pwm;
            if (pwm_duty < -max_pwm) pwm_duty = -max_pwm;
            Set_Motor_PWM(pwm_duty);

            g_traj_pos       = traj_start_pos + pos_ideal;
            g_smooth_vel     = smooth_vel;
            g_smooth_accel   = smooth_accel;
            g_jerk           = jerk_out;
            g_position_rad   = my_encoder.position_rad;
            g_velocity_rad_s = vel_filtered;
            g_pwm_duty       = pwm_duty;
            break;
        }

        case MODE_ENCODER_TEST: {
            /* ---- MODE 4: Encoder test ----
             * Motor output is zero. Reads and displays encoder data only.
             * Rotate the shaft by hand and observe in Live Expressions:
             *   enc_position_deg  — absolute position (degrees)
             *   enc_velocity_rpm  — angular velocity (RPM)
             *   enc_raw_counter   — raw TIM1 counter (0-65535)
             *   enc_count_accum   — 32-bit accumulated count
             *
             * Telemetry channels in this mode:
             *   g_position_rad   → position (rad)
             *   g_velocity_rad_s → velocity (rad/s)
             *   g_smooth_vel     → position (deg)
             *   g_smooth_accel   → velocity (RPM)
             *   g_pwm_duty       → raw TIM1 counter          */
            Set_Motor_PWM(0.0f);

            uint16_t raw_timer = __HAL_TIM_GET_COUNTER(&htim1);
            Encoder_Update(&my_encoder, raw_timer);

            // Convert to user-friendly units
            enc_position_deg = my_encoder.position_rad * (180.0f / 3.14159265f);
            enc_velocity_rpm = my_encoder.velocity_rad_s * (60.0f / (2.0f * 3.14159265f));
            enc_raw_counter  = (uint32_t)raw_timer;
            enc_count_accum  = my_encoder.count_accum;

            // UART packet — no trajectory in this mode, zero trajectory channels
            g_traj_pos     = 0.0f;
            g_smooth_vel   = 0.0f;
            g_smooth_accel = 0.0f;
            g_jerk         = 0.0f;
            // Live Expressions — encoder readback via dedicated variables above
            g_position_rad   = my_encoder.position_rad;
            g_velocity_rad_s = my_encoder.velocity_rad_s;
            g_pwm_duty       = (float)enc_raw_counter;
            break;
        }

        case MODE_POS_VEL_CTRL: {
            /* ---- MODE 5: Position PID → Velocity PID (no trajectory) ----
             *
             * Outer loop — Position PID with deadband:
             *   vel_command = Position_PID(target − actual)   clamped ±max_velocity
             *
             * Inner loop — Velocity PID:
             *   vel_error = vel_command − filtered_velocity → PWM
             *
             * No trajectory — raw step response.
             * Compare with Mode 3 to see what the trajectory adds.     */
            uint16_t raw_timer = __HAL_TIM_GET_COUNTER(&htim1);
            Encoder_Update(&my_encoder, raw_timer);

            // Velocity low-pass filter
            vel_filtered = vel_filter_alpha * my_encoder.velocity_rad_s
                         + (1.0f - vel_filter_alpha) * vel_filtered;

            // Outer loop: position PID with deadband
            float target_rad   = traj_target_deg * DEG_TO_RAD;
            float pos_error    = target_rad - my_encoder.position_rad;
            float deadband_rad = pos_deadband_deg * DEG_TO_RAD;

            float pos_error_eff = 0.0f;
            if (pos_error >  deadband_rad) pos_error_eff = pos_error - deadband_rad;
            if (pos_error < -deadband_rad) pos_error_eff = pos_error + deadband_rad;

            float vel_command = Position_PID_Controller(pos_error_eff, vel_filtered);
            if (vel_command >  max_velocity) vel_command =  max_velocity;
            if (vel_command < -max_velocity) vel_command = -max_velocity;

            // Hard stop: inside deadband and motor settled
            if (fabsf(pos_error) <= deadband_rad && fabsf(vel_filtered) < 0.05f) {
                Velocity_PID_Reset();
                Position_PID_Reset();
                Set_Motor_PWM(0.0f);
                g_traj_pos     = 0.0f;
                g_smooth_vel   = 0.0f;
                g_smooth_accel = 0.0f;
                g_jerk         = 0.0f;
                g_position_rad   = my_encoder.position_rad;
                g_velocity_rad_s = vel_filtered;
                g_pwm_duty       = 0.0f;
                ss_error_deg     = pos_error * (180.0f / 3.14159265f);
                ss_error_rad     = pos_error;
                break;
            }

            // Inner loop: velocity PID
            float vel_error = vel_command - vel_filtered;
            vel_error_live  = vel_error;
            ss_error_deg    = pos_error * (180.0f / 3.14159265f);
            ss_error_rad    = pos_error;

            float pwm_duty  = Velocity_PID_Controller(vel_error);
            Set_Motor_PWM(pwm_duty);

            g_traj_pos     = 0.0f;
            g_smooth_vel   = 0.0f;
            g_smooth_accel = 0.0f;
            g_jerk         = 0.0f;
            g_position_rad   = my_encoder.position_rad;
            g_velocity_rad_s = vel_filtered;
            g_pwm_duty       = pwm_duty;
            break;
        }

        case MODE_DIRECT_POS: {
            /* ---- MODE 6: Direct position PID → PWM (no trajectory, no velocity PID) ----
             *
             * Full PID on position error → PWM directly:
             *   pos_error = traj_target_deg − actual_position
             *   pwm       = kp_pos_pwm × err
             *             + ki_pos_pwm × ∫err dt   (integral, anti-windup clamped)
             *             − kd_pos_pwm × velocity   (derivative via -velocity, not Δerr)
             *
             * Tuning guide (Live Expressions):
             *   kp_pos_pwm  — start 20.  Motor should reach target but may overshoot.
             *   ki_pos_pwm  — start 0.   Increase slowly to eliminate steady-state error.
             *   kd_pos_pwm  — start 0.   Increase to damp overshoot.
             *   pos_deadband_deg — dead zone; motor stops when error inside this band. */
            uint16_t raw_timer = __HAL_TIM_GET_COUNTER(&htim1);
            Encoder_Update(&my_encoder, raw_timer);

            float target_rad   = traj_target_deg * DEG_TO_RAD;
            float pos_error    = target_rad - my_encoder.position_rad;
            float deadband_rad = pos_deadband_deg * DEG_TO_RAD;

            ss_error_rad = pos_error;
            ss_error_deg = pos_error * (180.0f / 3.14159265f);

            // Hard stop inside deadband — also drain integral
            if (fabsf(pos_error) <= deadband_rad &&
                fabsf(my_encoder.velocity_rad_s) < 0.05f) {
                pos6_integral    = 0.0f;
                Set_Motor_PWM(0.0f);
                g_position_rad   = my_encoder.position_rad;
                g_velocity_rad_s = my_encoder.velocity_rad_s;
                g_smooth_vel     = 0.0f;
                g_smooth_accel   = 0.0f;
                g_pwm_duty       = 0.0f;
                break;
            }

            // Apply deadband to error fed into PID
            float pos_error_eff = 0.0f;
            if (pos_error >  deadband_rad) pos_error_eff = pos_error - deadband_rad;
            if (pos_error < -deadband_rad) pos_error_eff = pos_error + deadband_rad;

            // Integral with anti-windup — clamp accumulator so i_out ≤ max_pwm
            pos6_integral += pos_error_eff * LOOP_DT;
            float max6_int = (ki_pos_pwm > 0.0f) ? (max_pwm / ki_pos_pwm) : 0.0f;
            if (pos6_integral >  max6_int) pos6_integral =  max6_int;
            if (pos6_integral < -max6_int) pos6_integral = -max6_int;

            float pwm_duty = kp_pos_pwm * pos_error_eff
                           + ki_pos_pwm * pos6_integral
                           - kd_pos_pwm * my_encoder.velocity_rad_s;
            if (pwm_duty >  max_pwm) pwm_duty =  max_pwm;
            if (pwm_duty < -max_pwm) pwm_duty = -max_pwm;
            Set_Motor_PWM(pwm_duty);

            g_traj_pos     = 0.0f;
            g_smooth_vel   = 0.0f;
            g_smooth_accel = 0.0f;
            g_jerk         = 0.0f;
            g_position_rad   = my_encoder.position_rad;
            g_velocity_rad_s = my_encoder.velocity_rad_s;
            g_pwm_duty       = pwm_duty;
            break;
        }

        default:
            Set_Motor_PWM(0.0f);
            break;
    }

    // Pack telemetry — main loop transmits over UART
    if (!tx_pending) {
        Pack_Telemetry();
        tx_pending = 1;
    }
}

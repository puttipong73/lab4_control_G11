// --- Velocity PID gains (tunable in Live Expressions) ---
// kp_vel sizing: output = kp_vel × vel_error [rad/s]  →  PWM [%]
// Rule: kp_vel = max_pwm / max_velocity = 100 / 1.57 ≈ 64 gives full PWM at max error.
// Start at 30 (≈ half authority) and tune up until motor tracks trajectory cleanly.
// kd_vel stays 0: derivative amplifies quantization noise at 1 kHz.
float kp_vel = 30.0f;
float ki_vel =  0.1f;
float kd_vel =  0.0f;

float vel_integral    = 0.0f;
float vel_prev_error  = 0.0f;
float max_pwm         = 100.0f;

// --- Position PID gains — Modes 3 & 5 output: velocity (rad/s) ---
// kp_position: [rad/s] per [rad] of error. Start at 1.0, tune up carefully.
volatile float kp_position       = 1.0f;
volatile float ki_pos            = 0.0f;
volatile float kd_pos            = 0.0f;
volatile float pos_deadband_deg  = 2.0f;
volatile float pos_integral_live = 0.0f;

float pos_integral  = 0.0f;
float pos6_integral = 0.0f;   // Mode 6 direct-position PID integrator

// --- Position PID gains — Modes 2 & 6 output: PWM (%) ---
// kp_pos_pwm needs to be much larger than kp_position because the output
// is directly PWM (%) not velocity (rad/s).
// Rule of thumb: kp=20, ki=0 (add slowly to eliminate steady-state error), kd=0.
volatile float kp_pos_pwm = 20.0f;   // [%] per [rad]
volatile float ki_pos_pwm =  0.0f;   // [%] per [rad·s]  — use to kill steady-state error
volatile float kd_pos_pwm =  0.0f;   // [%] per [rad/s]  — damps via -velocity

// --- Velocity IIR low-pass filter (applied AFTER windowed velocity) ---
// The 10-tick window already removes most quantization noise.
// This IIR provides additional smoothing for the PID input.
// alpha=0.5 → cutoff ≈ 80 Hz — less lag than the old 0.2 setting.
volatile float vel_filter_alpha = 0.5f;
volatile float vel_filtered     = 0.0f;

float Velocity_PID_Controller(float error) {
    // Proportional
    float p_out = kp_vel * error;

    // Integral with proper anti-windup:
    // Clamp the ACCUMULATOR itself so i_out can never exceed max_pwm.
    // The old approach only clamped i_out at output but let vel_integral
    // grow without bound — causing the motor to keep running after trajectory ends.
    vel_integral += error * LOOP_DT;
    float max_integral = (ki_vel > 0.0f) ? (max_pwm / ki_vel) : 0.0f;
    if (vel_integral >  max_integral) vel_integral =  max_integral;
    if (vel_integral < -max_integral) vel_integral = -max_integral;
    float i_out = ki_vel * vel_integral;

    // Derivative
    float derivative = (error - vel_prev_error) / LOOP_DT;
    float d_out      = kd_vel * derivative;
    vel_prev_error   = error;

    // Expose internals for Live Expressions debugging
    i_term_live = vel_integral;

    // Total output — clamped to PWM limits
    float output = p_out + i_out + d_out;
    if (output >  max_pwm) output =  max_pwm;
    if (output < -max_pwm) output = -max_pwm;

    return output;
}

void Velocity_PID_Reset(void) {
    vel_integral   = 0.0f;
    vel_prev_error = 0.0f;
}

/* Position PID controller.
 *   pos_error    : target_pos − actual_pos  (radians)
 *   vel_feedback : filtered actual velocity  (rad/s)
 *   returns      : velocity command (rad/s) for Modes 3 & 5
 *                  or PWM duty (%) for Mode 2 — caller applies limits.
 *
 * Derivative term uses −velocity instead of Δerror/dt.
 * Reason: d(pos_error)/dt = −d(actual)/dt = −velocity.
 * Using measured velocity is far less noisy than differencing position error. */
float Position_PID_Controller(float pos_error, float vel_feedback) {
    float p_out = kp_position * pos_error;

    // Integral with anti-windup — clamp accumulator so i_out ≤ max_velocity
    pos_integral += pos_error * LOOP_DT;
    float max_pos_int = (ki_pos > 0.0f) ? (max_velocity / ki_pos) : 0.0f;
    if (pos_integral >  max_pos_int) pos_integral =  max_pos_int;
    if (pos_integral < -max_pos_int) pos_integral = -max_pos_int;
    float i_out = ki_pos * pos_integral;
    pos_integral_live = pos_integral;

    // Derivative: negate velocity (= derivative of position error)
    float d_out = -kd_pos * vel_feedback;

    return p_out + i_out + d_out;
}

void Position_PID_Reset(void) {
    pos_integral      = 0.0f;
    pos_integral_live = 0.0f;
}

static void Pack_Telemetry(void) {
    // 20-byte packet: [0x7E][0x7E][pos 4B][vel 4B][accel 4B][jerk 4B][0x03][0x03]
    tx_buf[0] = 0x7E;
    tx_buf[1] = 0x7E;
    // Cast away volatile — safe here because we are copying to a TX buffer
    memcpy(&tx_buf[2],  (const void *)&g_traj_pos,    4);
    memcpy(&tx_buf[6],  (const void *)&g_smooth_vel,  4);
    memcpy(&tx_buf[10], (const void *)&g_smooth_accel, 4);
    memcpy(&tx_buf[14], (const void *)&g_jerk,         4);
    tx_buf[18] = 0x03;
    tx_buf[19] = 0x03;
}


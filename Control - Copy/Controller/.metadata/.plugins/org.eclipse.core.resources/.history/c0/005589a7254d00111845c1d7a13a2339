  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_LPUART1_UART_Init();
  MX_TIM1_Init();
  MX_TIM6_Init();
  MX_TIM3_Init();
  /* USER CODE BEGIN 2 */
  // 1. Initialize trajectory and profile math
      SCurve_Init(&my_scurve, max_velocity, max_accel, max_jerk, LOOP_DT);
      Trapezoid_Init(&my_trapezoid, max_velocity, max_accel, LOOP_DT);

      // 2. Start TIM1 encoder, zero its counter, THEN init encoder struct.
      //    Order matters: counter must be zeroed before Encoder_Init reads
      //    last_counter_value = 0, so the first delta is always 0.
      HAL_TIM_Encoder_Start(&htim1, TIM_CHANNEL_ALL);
      __HAL_TIM_SET_COUNTER(&htim1, 0);
      Encoder_Init(&my_encoder, LOOP_DT);

      // 3. Start TIM3 PWM output
      HAL_TIM_PWM_Start(&htim3, TIM_CHANNEL_1);

      // 4. Start TIM6 control loop interrupt (1000 Hz)
      HAL_TIM_Base_Start_IT(&htim6);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  if (tx_pending) {
        tx_pending = 0;
        HAL_UART_Transmit(&hlpuart1, tx_buf, sizeof(tx_buf), 2);
    }
  }
  /* USER CODE END 3 */
}

